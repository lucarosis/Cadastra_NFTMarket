# Copy to .env.local (never commit real values).

# Production database (required on Vercel). Locally, leave it empty: the app uses
# a built-in database in .data/pglite. Vercel's Postgres integration sets POSTGRES_URL,
# which works too.
DATABASE_URL=

# Signs the session cookie that unlocks artwork. Required in production:
# without it the server issues no sessions and accepts none.
# Generate with:  openssl rand -base64 32
SESSION_SECRET=

# Where rendered previews are cached. Default: .data/media-cache
# MEDIA_CACHE_DIR=

# Optional CoinGecko demo key, for the XTZ rate and the crypto price strip.
# PRICE_FEED_KEY=
